<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>MIG</PackageId>
    <Version>1.3.11</Version>
    <Authors>Generoso Martello</Authors>
    <Company>G-Labs</Company>
    <Description>MIG is a .NET library providing an integrated solution for developing multi-protocol networked applications and real time web applications.</Description>
    <PackageLicense>./LICENSE</PackageLicense>
    <PackageProjectUrl>https://github.com/genielabs/mig-service-dotnet/</PackageProjectUrl>
    <PackageTags>web gateway middleware multi-protocol networking interoperability</PackageTags>
    <OutputType>Library</OutputType>
    <TargetFrameworks>netstandard2.0;net472;net8.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Link>README.md</Link>
    </None>
  </ItemGroup>

  <!-- Target .NET 10 -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.12"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12"/>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12"/>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.12"/>
  </ItemGroup>

  <!-- Target .NET 8 (LTS) -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="8.0.1"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1"/>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1"/>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0"/>
  </ItemGroup>

  <!-- Target Legacy (.NET Standard 2.0 / .NET Framework 4.7.2) -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'net472' ">
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="2.2.0"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="2.2.0"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="2.2.0"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="2.2.0"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="2.2.0"/>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="2.2.0"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="2.2.0"/>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="4.5.1"/>
  </ItemGroup>

  <!-- Common -->
  <ItemGroup>
    <PackageReference Include="GLabs.Logging" Version="1.1.1" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0"/>
    <PackageReference Include="WebsocketSharp.Standard2" Version="2022.4.16.1520"/>
    <PackageReference Include="MessagePack" Version="3.1.8"/>
    <PackageReference Include="MessagePack.Annotations" Version="3.1.8"/>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4"/>
    <PackageReference Include="Ude.NetStandard" Version="1.2.0"/>
  </ItemGroup>
</Project>
